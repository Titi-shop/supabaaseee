DROP TABLE IF EXISTS payment_audit_logs CASCADE;

CREATE TABLE payment_audit_logs (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),

  /* =====================================================
     EVENT ORDERING (STRICT AUDIT CHAIN)
  ===================================================== */

  event_index bigint GENERATED ALWAYS AS IDENTITY UNIQUE,

  /* =====================================================
     CORE REFERENCE (UUID ONLY)
  ===================================================== */

  payment_intent_id uuid NOT NULL
    REFERENCES payment_intents(id)
    ON DELETE CASCADE,

  order_id uuid NULL,
  escrow_id uuid NULL,

  /* =====================================================
     EXTERNAL SYSTEM REFERENCES (NO RELATION)
  ===================================================== */

  pi_payment_id text NULL,
  txid text NULL,

  /* =====================================================
     EVENT CLASSIFICATION
  ===================================================== */

  event_code text NOT NULL,
  stage text NOT NULL,

  severity text NOT NULL DEFAULT 'info'
    CHECK (severity IN ('info','warn','error','critical')),

  /* =====================================================
     ACTOR MODEL (V7 COMPLIANT - AUTH IS OUTSIDE DB)
  ===================================================== */

  actor_type text NOT NULL DEFAULT 'system'
    CHECK (actor_type IN (
      'system',
      'api',
      'cron',
      'admin',
      'pi_api',
      'rpc',
      'ledger'
    )),

  actor_id uuid NULL,

  source text NULL,
  request_id text NULL,

  /* =====================================================
     STATE TRANSITION TRACKING
  ===================================================== */

  old_payment_status text NULL,
  new_payment_status text NULL,

  old_settlement_state text NULL,
  new_settlement_state text NULL,

  reconcile_attempt integer NOT NULL DEFAULT 0,

  /* =====================================================
     HUMAN / DEBUG CONTEXT
  ===================================================== */

  note text NULL,

  payload jsonb NOT NULL DEFAULT '{}'::jsonb,

  /* =====================================================
     CHAINING / INTEGRITY (EVENT IMMUTABILITY)
  ===================================================== */

  prev_hash text NULL,
  event_hash text NOT NULL,

  /* =====================================================
     TIMESTAMP
  ===================================================== */

  created_at timestamptz NOT NULL DEFAULT now()
);
