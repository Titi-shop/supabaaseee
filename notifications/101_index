/* ================= USER FEED ================= */

CREATE INDEX IF NOT EXISTS idx_notifications_user_feed
ON public.notifications(user_id, created_at DESC)
WHERE deleted_at IS NULL;


/* ================= UNREAD ================= */

CREATE INDEX IF NOT EXISTS idx_notifications_user_unread
ON public.notifications(user_id, is_read)
WHERE deleted_at IS NULL;


/* ================= SEEN ================= */

CREATE INDEX IF NOT EXISTS idx_notifications_user_seen
ON public.notifications(user_id, is_seen)
WHERE deleted_at IS NULL;


/* ================= TYPE ================= */

CREATE INDEX IF NOT EXISTS idx_notifications_type
ON public.notifications(type);


/* ================= CATEGORY ================= */

CREATE INDEX IF NOT EXISTS idx_notifications_category
ON public.notifications(category);


/* ================= PRIORITY ================= */

CREATE INDEX IF NOT EXISTS idx_notifications_priority
ON public.notifications(priority);


/* ================= PUSH ================= */

CREATE INDEX IF NOT EXISTS idx_notifications_push
ON public.notifications(is_pushed);


/* ================= TIME ================= */

CREATE INDEX IF NOT EXISTS idx_notifications_created_at
ON public.notifications(created_at DESC);


/* ================= SOFT DELETE ================= */

CREATE INDEX IF NOT EXISTS idx_notifications_not_deleted
ON public.notifications(id)
WHERE deleted_at IS NULL;


/* ================= DEDUPE ================= */

CREATE UNIQUE INDEX IF NOT EXISTS idx_notifications_dedupe
ON public.notifications(dedupe_key)
WHERE dedupe_key IS NOT NULL;
