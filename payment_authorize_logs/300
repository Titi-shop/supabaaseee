DROP TABLE IF EXISTS payment_authorize_logs CASCADE;

CREATE TABLE payment_authorize_logs (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),

  auth_index bigint GENERATED ALWAYS AS IDENTITY UNIQUE,

  payment_intent_id uuid NOT NULL
    REFERENCES payment_intents(id)
    ON DELETE CASCADE,

  pi_payment_id text NOT NULL,
  pi_uid text NOT NULL,

  nonce text NOT NULL,
  verify_token text NOT NULL,

  merchant_wallet text NOT NULL,

  expected_amount numeric(20,7) NOT NULL
    CHECK (expected_amount >= 0),

  verified_amount numeric(20,7) NOT NULL
    CHECK (verified_amount >= 0),

  currency text NOT NULL DEFAULT 'PI'
    CHECK (currency = 'PI'),

  authorize_status text NOT NULL DEFAULT 'RECEIVED'
    CHECK (authorize_status IN (
      'RECEIVED',
      'VERIFIED',
      'DUPLICATE',
      'REJECTED',
      'REPLAY_BLOCKED'
    )),

  idempotency_fingerprint text NULL,

  source text NULL,
  request_id text NULL,
  client_ip text NULL,
  user_agent text NULL,

  note text NULL,

  payload jsonb NOT NULL DEFAULT '{}'::jsonb,

  prev_hash text NULL,
  event_hash text NOT NULL,

  created_at timestamptz NOT NULL DEFAULT now()
);

CREATE INDEX idx_payment_authorize_logs_intent
ON payment_authorize_logs(payment_intent_id);

CREATE INDEX idx_payment_authorize_logs_pi_payment
ON payment_authorize_logs(pi_payment_id);

CREATE INDEX idx_payment_authorize_logs_pi_uid
ON payment_authorize_logs(pi_uid);
