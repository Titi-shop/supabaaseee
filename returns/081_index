/* ================= RELATION ================= */

CREATE INDEX IF NOT EXISTS idx_returns_order_id
ON public.returns(order_id);

CREATE INDEX IF NOT EXISTS idx_returns_buyer_id
ON public.returns(buyer_id);

CREATE INDEX IF NOT EXISTS idx_returns_seller_id
ON public.returns(seller_id);


/* ================= STATUS ================= */

CREATE INDEX IF NOT EXISTS idx_returns_status
ON public.returns(status);

CREATE INDEX IF NOT EXISTS idx_returns_refund_status
ON public.returns(refund_status);


/* ================= SELLER DASHBOARD ================= */

CREATE INDEX IF NOT EXISTS idx_returns_seller_status
ON public.returns(seller_id, status)
WHERE deleted_at IS NULL;


/* ================= BUYER ================= */

CREATE INDEX IF NOT EXISTS idx_returns_buyer_status
ON public.returns(buyer_id, status)
WHERE deleted_at IS NULL;


/* ================= TIME ================= */

CREATE INDEX IF NOT EXISTS idx_returns_created_at
ON public.returns(created_at DESC);


/* ================= SHIPPING ================= */

CREATE INDEX IF NOT EXISTS idx_returns_tracking
ON public.returns(return_tracking_code);


/* ================= SOFT DELETE ================= */

CREATE INDEX IF NOT EXISTS idx_returns_not_deleted
ON public.returns(id)
WHERE deleted_at IS NULL;
