/* ================= USER ================= */

CREATE INDEX IF NOT EXISTS idx_seller_requests_user_id
ON public.seller_requests(user_id);


/* ================= STATUS ================= */

CREATE INDEX IF NOT EXISTS idx_seller_requests_status
ON public.seller_requests(status);

/* admin dashboard */
CREATE INDEX IF NOT EXISTS idx_seller_requests_status_created
ON public.seller_requests(status, created_at DESC)
WHERE deleted_at IS NULL;


/* ================= SHOP ================= */

CREATE UNIQUE INDEX IF NOT EXISTS idx_seller_requests_shop_slug
ON public.seller_requests(shop_slug);


/* ================= REVIEW ================= */

CREATE INDEX IF NOT EXISTS idx_seller_requests_reviewed_by
ON public.seller_requests(reviewed_by);


/* ================= TIME ================= */

CREATE INDEX IF NOT EXISTS idx_seller_requests_created_at
ON public.seller_requests(created_at DESC);


/* ================= SOFT DELETE ================= */

CREATE INDEX IF NOT EXISTS idx_seller_requests_not_deleted
ON public.seller_requests(id)
WHERE deleted_at IS NULL;
