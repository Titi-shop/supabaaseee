/* =========================================================
   DROP OLD
========================================================= */

DROP TABLE IF EXISTS cart_items CASCADE;

/* =========================================================
   CART ITEMS V7
   FULLY SYNC WITH PRODUCTS TABLE
========================================================= */

CREATE TABLE cart_items (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),

  /* =====================================================
     OWNER
  ===================================================== */

  user_id uuid NOT NULL,

  /* =====================================================
     PRODUCT RELATION
  ===================================================== */

  product_id uuid NOT NULL,
  variant_id uuid,

  /* =====================================================
     GENERATED UNIQUE KEY
  ===================================================== */

  variant_key uuid GENERATED ALWAYS AS (
    COALESCE(
      variant_id,
      '00000000-0000-0000-0000-000000000000'::uuid
    )
  ) STORED,

  seller_id uuid NOT NULL,

  /* =====================================================
     PRODUCT SNAPSHOT
  ===================================================== */

  product_name text NOT NULL DEFAULT '',
  product_slug text NOT NULL DEFAULT '',

  short_description text NOT NULL DEFAULT '',

  thumbnail text NOT NULL DEFAULT '',

  images text[] NOT NULL DEFAULT '{}',

  video_url text NOT NULL DEFAULT '',

  /* =====================================================
     CATEGORY
  ===================================================== */

  category_id integer,

  /* =====================================================
     PRICE SNAPSHOT
  ===================================================== */

  currency text NOT NULL DEFAULT 'PI',

  unit_price numeric NOT NULL DEFAULT 0,

  sale_price numeric,

  final_price numeric NOT NULL DEFAULT 0,

  price_snapshot numeric NOT NULL DEFAULT 0,

  /* =====================================================
     STOCK SNAPSHOT
  ===================================================== */

  stock_snapshot integer NOT NULL DEFAULT 0,

  is_unlimited boolean NOT NULL DEFAULT false,

  is_out_of_stock boolean NOT NULL DEFAULT false,

  /* =====================================================
     SALE SNAPSHOT
  ===================================================== */

  sale_enabled boolean NOT NULL DEFAULT false,

  sale_start timestamptz,

  sale_end timestamptz,

  /* =====================================================
     PRODUCT FLAGS SNAPSHOT
  ===================================================== */

  is_active boolean NOT NULL DEFAULT true,

  is_featured boolean NOT NULL DEFAULT false,

  is_digital boolean NOT NULL DEFAULT false,

  status text NOT NULL DEFAULT 'active',

  /* =====================================================
     CHANGE DETECTION
  ===================================================== */

  is_price_changed boolean NOT NULL DEFAULT false,

  is_product_changed boolean NOT NULL DEFAULT false,

  /* =====================================================
     CART STATE
  ===================================================== */

  quantity integer NOT NULL DEFAULT 1
    CHECK (quantity > 0),

  is_selected boolean NOT NULL DEFAULT true,

  is_available boolean NOT NULL DEFAULT true,

  /* =====================================================
     USER META
  ===================================================== */

  note text,

  added_from text,

  /* =====================================================
     TIME
  ===================================================== */

  created_at timestamptz NOT NULL DEFAULT now(),

  updated_at timestamptz NOT NULL DEFAULT now(),

  deleted_at timestamptz
);

/* =========================================================
   UNIQUE CONSTRAINT
========================================================= */

CREATE UNIQUE INDEX cart_items_unique_idx
ON cart_items (
  user_id,
  product_id,
  variant_key
);

/* =========================================================
   PERFORMANCE INDEXES
========================================================= */

CREATE INDEX cart_items_user_idx
ON cart_items(user_id);

CREATE INDEX cart_items_product_idx
ON cart_items(product_id);

CREATE INDEX cart_items_seller_idx
ON cart_items(seller_id);

CREATE INDEX cart_items_deleted_idx
ON cart_items(deleted_at);

CREATE INDEX cart_items_selected_idx
ON cart_items(is_selected);

CREATE INDEX cart_items_available_idx
ON cart_items(is_available);

CREATE INDEX cart_items_status_idx
ON cart_items(status);

/* =========================================================
   UPDATED_AT AUTO UPDATE
========================================================= */

CREATE OR REPLACE FUNCTION update_cart_items_updated_at()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$;

CREATE TRIGGER trg_cart_items_updated_at
BEFORE UPDATE
ON cart_items
FOR EACH ROW
EXECUTE FUNCTION update_cart_items_updated_at();
