CREATE TABLE seller_withdrawals (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),

  /* =====================================================
     OWNERSHIP (UUID ONLY - V7 RULE)
  ===================================================== */

  seller_id uuid NOT NULL,

  seller_credit_id uuid NOT NULL
    REFERENCES seller_credits(id)
    ON DELETE CASCADE,

  /* =====================================================
     FINANCIAL DATA
  ===================================================== */

  amount numeric(18,8) NOT NULL
    CHECK (amount > 0),

  currency text NOT NULL DEFAULT 'PI'
    CHECK (currency = 'PI'),

  /* =====================================================
     WITHDRAWAL DESTINATION
  ===================================================== */

  withdraw_wallet text NOT NULL,

  /* =====================================================
     CHAIN / PAYMENT TRACEABILITY
  ===================================================== */

  txid text,

  /* =====================================================
     WITHDRAW STATE MACHINE
  ===================================================== */

  status text NOT NULL DEFAULT 'PENDING'
    CHECK (status IN (
      'PENDING',
      'SENT',
      'FAILED',
      'CANCELLED'
    )),

  /* =====================================================
     TIMELINE
  ===================================================== */

  requested_at timestamptz NOT NULL DEFAULT now(),
  completed_at timestamptz,

  /* =====================================================
     FAILURE TRACKING (NO RAW ERROR LEAK)
  ===================================================== */

  fail_reason text
);
