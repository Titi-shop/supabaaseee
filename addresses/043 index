/* ================= CORE ================= */

-- 🔥 Load tất cả address của user
CREATE INDEX IF NOT EXISTS idx_addresses_user
ON public.addresses(user_id);

-- 🔥 Default address (cực quan trọng)
CREATE INDEX IF NOT EXISTS idx_addresses_user_default
ON public.addresses(user_id, is_default)
WHERE deleted_at IS NULL;

/* ================= SOFT DELETE ================= */

-- 🔥 chỉ lấy address chưa xoá
CREATE INDEX IF NOT EXISTS idx_addresses_not_deleted
ON public.addresses(user_id)
WHERE deleted_at IS NULL;

/* ================= UNIQUE RULE ================= */

-- 🔥 đảm bảo mỗi user chỉ có 1 default
CREATE UNIQUE INDEX IF NOT EXISTS idx_addresses_one_default
ON public.addresses(user_id)
WHERE is_default = true AND deleted_at IS NULL;

/* ================= FILTER ================= */

-- 🔥 filter theo label (home / office / other)
CREATE INDEX IF NOT EXISTS idx_addresses_label
ON public.addresses(label);

-- 🔥 filter verified
CREATE INDEX IF NOT EXISTS idx_addresses_verified
ON public.addresses(is_verified);

/* ================= GEO (FUTURE) ================= */

-- 🔥 tìm gần vị trí (basic)
CREATE INDEX IF NOT EXISTS idx_addresses_geo
ON public.addresses(latitude, longitude);

/* ================= SORT ================= */

-- 🔥 list theo thời gian
CREATE INDEX IF NOT EXISTS idx_addresses_created_at
ON public.addresses(created_at DESC);
