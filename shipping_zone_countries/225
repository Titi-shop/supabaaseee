-- SHIPPING ZONE COUNTRIES COMPLETE WORLD MAP
-- KEEP EXISTING TABLE STRUCTURE
-- =========================================================

delete from public.shipping_zone_countries;

-- =========================================================
-- DOMESTIC
-- domestic không insert country cố định
-- vì dùng shipping_rates.domestic_country_code riêng từng seller
-- =========================================================



-- =========================================================
-- SEA (SOUTHEAST ASIA)
-- =========================================================
insert into public.shipping_zone_countries (zone_id, country_code)
select z.id, c.country_code
from public.shipping_zones z,
unnest(array[
'VN','TH','SG','MY','ID','PH','BN','KH','LA','MM','TL'
]) as c(country_code)
where z.code='sea';



