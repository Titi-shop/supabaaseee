-- =========================================================
-- 8. SHIPPING RATES TABLE
-- =========================================================
create table if not exists public.shipping_rates (
  id uuid primary key default gen_random_uuid(),

  product_id uuid not null
    references public.products(id)
    on delete cascade,

  zone_id uuid not null
    references public.shipping_zones(id)
    on delete cascade,

  price numeric(18,5) not null check(price >= 0),

  currency text not null default 'PI'
    check(currency='PI'),

  -- 🔥 domestic custom country flexible
  domestic_country_code text null,

  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),

  unique(product_id, zone_id)
);

create index if not exists idx_shipping_rates_zone
on public.shipping_rates(zone_id);

create index if not exists idx_shipping_rates_product
on public.shipping_rates(product_id);

create index if not exists idx_shipping_rates_domestic_country
on public.shipping_rates(domestic_country_code);

