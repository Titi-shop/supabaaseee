INSERT INTO shipping_zone_countries (zone_id, country_code)
SELECT sz.id, c.country_code
FROM shipping_zones sz,
UNNEST(ARRAY[
'BN','KH','ID','LA','MY','MM','PH','SG','TH','TL'
]) AS c(country_code)
WHERE sz.code='sea'
ON CONFLICT DO NOTHING;
