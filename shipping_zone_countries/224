-- =========================================
-- DOMESTIC
-- =========================================
INSERT INTO shipping_zone_countries (zone_id, country_code)
SELECT id, 'VN'
FROM shipping_zones
WHERE code = 'domestic';

-- =========================================
-- ASIA
-- =========================================
INSERT INTO shipping_zone_countries (zone_id, country_code)
SELECT sz.id, c.country_code
FROM shipping_zones sz,
UNNEST(ARRAY[
  'JP','KR','CN','HK','TW',
  'TH','SG','MY','ID','PH','VN',
  'IN','PK','BD','LK',
  'AE','SA','QA','KW','OM','BH',
  'IL','TR'
]) AS c(country_code)
WHERE sz.code = 'asia';

