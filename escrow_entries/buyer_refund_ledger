CREATE TABLE buyer_refund_ledger (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),

  escrow_id uuid NOT NULL REFERENCES escrow_entries(id) ON DELETE CASCADE,
  buyer_id uuid NOT NULL,

  amount numeric(18,8) NOT NULL,

  reason text,
  status text NOT NULL DEFAULT 'PENDING',
  -- PENDING | REFUNDED | FAILED

  refund_txid text,
  pi_payment_id text,

  refund_source text NOT NULL DEFAULT 'SYSTEM',
  -- SYSTEM | ADMIN | DISPUTE

  approved_by uuid,

  processed_at timestamptz,
  fail_reason text,

  created_at timestamptz NOT NULL DEFAULT now()
);
