CREATE TABLE payment_intents (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),

  /* =====================================================
     IDENTITY SNAPSHOT
  ===================================================== */

  buyer_id uuid NOT NULL
    REFERENCES users(id)
    ON DELETE RESTRICT,

  seller_id uuid NOT NULL
    REFERENCES users(id)
    ON DELETE RESTRICT,

  product_id uuid NOT NULL
    REFERENCES products(id)
    ON DELETE RESTRICT,

  variant_id uuid
    REFERENCES product_variants(id)
    ON DELETE SET NULL,

  quantity integer NOT NULL
    CHECK (quantity > 0 AND quantity <= 100),

  /* =====================================================
     PRICE SNAPSHOT
  ===================================================== */

  unit_price numeric(20,7) NOT NULL
    CHECK (unit_price >= 0),

  subtotal numeric(20,7) NOT NULL
    CHECK (subtotal >= 0),

  discount numeric(20,7) NOT NULL DEFAULT 0
    CHECK (discount >= 0),

  shipping_fee numeric(20,7) NOT NULL
    CHECK (shipping_fee >= 0),

  total_amount numeric(20,7) NOT NULL
    CHECK (total_amount >= 0),

  currency text NOT NULL DEFAULT 'PI'
    CHECK (currency = 'PI'),

  /* =====================================================
     SHIPPING SNAPSHOT
  ===================================================== */

  shipping_snapshot jsonb NOT NULL,

  country text NOT NULL,
  zone text NOT NULL,

  /* =====================================================
     PI PAYMENT / VERIFY SNAPSHOT
  ===================================================== */

  pi_payment_id text UNIQUE,

  pi_user_uid text,

  pi_verified_amount numeric(20,7),

  pi_payment_payload jsonb,

  /* =====================================================
     BLOCKCHAIN SNAPSHOT
  ===================================================== */

  txid text UNIQUE,

  merchant_wallet text NOT NULL,

  nonce text NOT NULL UNIQUE,

  /* =====================================================
     STATUS
  ===================================================== */

  status text NOT NULL DEFAULT 'created'
    CHECK (status IN (
      'created',        -- intent created
      'wallet_opened',  -- Pi approve done
      'submitted',      -- wallet user signed
      'verifying',      -- waiting reconcile
      'paid',           -- fully reconciled
      'failed',
      'expired'
    )),

  expires_at timestamptz NOT NULL
    DEFAULT (now() + interval '30 minutes'),

  paid_at timestamptz,

  failed_reason text,

  /* =====================================================
     TIME
  ===================================================== */

  created_at timestamptz NOT NULL DEFAULT now(),
  updated_at timestamptz NOT NULL DEFAULT now()
);
