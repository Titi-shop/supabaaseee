CREATE TABLE payment_intents (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),

  /* =====================================================
     PUBLIC / INTERNAL KEYS
  ===================================================== */

  nonce text NOT NULL UNIQUE,
  idempotency_key text NOT NULL UNIQUE,
  verify_token text NOT NULL UNIQUE,

  /* =====================================================
     IDENTITY SNAPSHOT
  ===================================================== */

  buyer_id uuid NOT NULL
    REFERENCES users(id)
    ON DELETE RESTRICT,

  seller_id uuid NOT NULL
    REFERENCES users(id)
    ON DELETE RESTRICT,

  product_id uuid NOT NULL
    REFERENCES products(id)
    ON DELETE RESTRICT,

  variant_id uuid
    REFERENCES product_variants(id)
    ON DELETE SET NULL,

  quantity integer NOT NULL
    CHECK (quantity > 0 AND quantity <= 100),

  /* =====================================================
     PRICE SNAPSHOT
  ===================================================== */

  unit_price numeric(20,7) NOT NULL
    CHECK (unit_price >= 0),

  subtotal numeric(20,7) NOT NULL
    CHECK (subtotal >= 0),

  discount numeric(20,7) NOT NULL DEFAULT 0
    CHECK (discount >= 0),

  shipping_fee numeric(20,7) NOT NULL
    CHECK (shipping_fee >= 0),

  total_amount numeric(20,7) NOT NULL
    CHECK (total_amount >= 0),

  currency text NOT NULL DEFAULT 'PI'
    CHECK (currency = 'PI'),

  /* =====================================================
     SHIPPING SNAPSHOT
  ===================================================== */

  shipping_snapshot jsonb NOT NULL,
  country text NOT NULL,
  zone text NOT NULL,

  /* =====================================================
     PI PAYMENT SNAPSHOT
  ===================================================== */

  pi_payment_id text UNIQUE,
  pi_user_uid text,
  pi_verified_amount numeric(20,7),
  pi_payment_payload jsonb,

  /* =====================================================
     BLOCKCHAIN SNAPSHOT
  ===================================================== */

  txid text UNIQUE,
  merchant_wallet text NOT NULL,

  /* =====================================================
     PAYMENT STATUS (USER JOURNEY)
  ===================================================== */

  status text NOT NULL DEFAULT 'created'
    CHECK (status IN (
      'created',
      'wallet_opened',
      'submitted',
      'verifying',
      'paid',
      'failed',
      'expired'
    )),

  /* =====================================================
     INTERNAL SETTLEMENT STATUS (BACKEND JOURNEY)
  ===================================================== */

  settlement_state text NOT NULL DEFAULT 'UNSETTLED'
    CHECK (settlement_state IN (
      'UNSETTLED',
      'PI_VERIFIED',
      'RPC_AUDITED',
      'PI_COMPLETED',
      'ORDER_FINALIZED',
      'LEDGER_POSTED',
      'SETTLED',
      'MANUAL_REVIEW'
    )),

  /* =====================================================
     RECONCILE CONTROL
  ===================================================== */

  reconcile_attempts integer NOT NULL DEFAULT 0
    CHECK (reconcile_attempts >= 0),

  last_reconcile_at timestamptz,

  settlement_lock_id uuid,
  settlement_locked_at timestamptz,
  settlement_lock_source text,

  /* =====================================================
     FAILURE / REVIEW
  ===================================================== */

  failed_reason text,
  manual_review_reason text,

  /* =====================================================
     TIME CONTROL
  ===================================================== */

  expires_at timestamptz NOT NULL
    DEFAULT (now() + interval '30 minutes'),

  paid_at timestamptz,
  settled_at timestamptz,

  created_at timestamptz NOT NULL DEFAULT now(),
  updated_at timestamptz NOT NULL DEFAULT now()
);
