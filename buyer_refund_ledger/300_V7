CREATE TABLE buyer_refund_ledger (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),

  /* =====================================================
     CORE LINK (ESCROW SOURCE OF TRUTH)
  ===================================================== */

  escrow_id uuid NOT NULL
    REFERENCES escrow_entries(id)
    ON DELETE CASCADE,

  buyer_id uuid NOT NULL,

  /* =====================================================
     FINANCIAL DATA
  ===================================================== */

  amount numeric(18,8) NOT NULL
    CHECK (amount > 0),

  /* =====================================================
     REFUND STATE MACHINE
  ===================================================== */

  status text NOT NULL DEFAULT 'PENDING'
    CHECK (status IN (
      'PENDING',
      'REFUNDED',
      'FAILED'
    )),

  /* =====================================================
     TRACEABILITY (NON-RELATIONAL IDS)
  ===================================================== */

  refund_txid text,
  pi_payment_id text,

  /* =====================================================
     REFUND ORIGIN
  ===================================================== */

  refund_source text NOT NULL DEFAULT 'SYSTEM'
    CHECK (refund_source IN (
      'SYSTEM',
      'ADMIN',
      'DISPUTE'
    )),

  approved_by uuid,

  /* =====================================================
     TIMELINE
  ===================================================== */

  processed_at timestamptz,

  /* =====================================================
     FAILURE TRACKING (NO RAW ERROR LEAKAGE)
  ===================================================== */

  fail_reason text,

  created_at timestamptz NOT NULL DEFAULT now()
);
