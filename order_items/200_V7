CREATE TABLE order_items (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),

  /* ================= RELATION ================= */

  order_id uuid NOT NULL REFERENCES orders(id) ON DELETE CASCADE,
  seller_id uuid NOT NULL REFERENCES users(id) ON DELETE RESTRICT,

  product_id uuid REFERENCES products(id) ON DELETE SET NULL,
  variant_id uuid,

  /* ================= PRODUCT SNAPSHOT ================= */

  product_name text NOT NULL DEFAULT '',
  product_slug text NOT NULL DEFAULT '',
  thumbnail text NOT NULL DEFAULT '',
  images text[] NOT NULL DEFAULT '{}',

  variant_name text NOT NULL DEFAULT '',
  variant_value text NOT NULL DEFAULT '',

  is_digital boolean NOT NULL DEFAULT false,

  /* ================= PRICE ================= */

  unit_price numeric NOT NULL DEFAULT 0 CHECK (unit_price >= 0),
  quantity integer NOT NULL DEFAULT 1 CHECK (quantity > 0 AND quantity <= 100),

  total_price numeric NOT NULL DEFAULT 0 CHECK (total_price >= 0),

  currency text NOT NULL DEFAULT 'PI'
    CHECK (currency = 'PI'),

  CONSTRAINT check_total_correct
    CHECK (total_price = unit_price * quantity),

  /* ================= FULFILLMENT STATUS ================= */

  fulfillment_status text NOT NULL DEFAULT 'pending'
    CHECK (fulfillment_status IN (
      'pending',
      'processing',
      'shipped',
      'delivered',
      'completed',
      'cancelled',
      'refunded'
    )),

  confirmed_at timestamptz,
  processing_at timestamptz,
  shipped_at timestamptz,
  delivered_at timestamptz,
  completed_at timestamptz,

  /* ================= SHIPPING ================= */

  tracking_code text,
  shipping_provider text,

  /* ================= SELLER ACTION ================= */

  seller_message text NOT NULL DEFAULT '',
  seller_cancel_reason text NOT NULL DEFAULT '',

  /* ================= REFUND ================= */

  refunded_amount numeric NOT NULL DEFAULT 0 CHECK (refunded_amount >= 0),
  refunded_at timestamptz,

  /* ================= ANALYTICS ================= */

  cost_price numeric CHECK (cost_price >= 0),
  profit_amount numeric,

  /* ================= SNAPSHOT ================= */

  snapshot jsonb,

  /* ================= TIME ================= */

  created_at timestamptz NOT NULL DEFAULT now(),
  updated_at timestamptz NOT NULL DEFAULT now(),
  deleted_at timestamptz
);
