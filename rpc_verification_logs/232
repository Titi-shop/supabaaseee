-- 1. UNIQUE TXID (CRITICAL)
CREATE UNIQUE INDEX rpc_verification_logs_txid_unique
ON rpc_verification_logs (txid);

-- 2. PAYMENT INTENT LOOKUP
CREATE INDEX rpc_verification_logs_payment_intent_idx
ON rpc_verification_logs (payment_intent_id);

-- 3. COMPOSITE FAST LOOKUP
CREATE INDEX rpc_verification_logs_intent_txid_idx
ON rpc_verification_logs (payment_intent_id, txid);

-- 4. TIME SERIES LOGS
CREATE INDEX rpc_verification_logs_created_at_idx
ON rpc_verification_logs (created_at DESC);

-- 5. FAILED ONLY (OPTIONAL)
CREATE INDEX rpc_verification_logs_failed_idx
ON rpc_verification_logs (verified)
WHERE verified = false;
