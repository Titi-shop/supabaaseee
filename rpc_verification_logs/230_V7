CREATE TABLE rpc_verification_logs (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),

  /* =====================================================
     RELATION (UUID CORE FLOW)
  ===================================================== */

  payment_intent_id uuid
    REFERENCES payment_intents(id)
    ON DELETE SET NULL,

  pi_payment_id text,

  /* =====================================================
     CHAIN CORE IDENTIFIERS
  ===================================================== */

  txid text NOT NULL UNIQUE,

  chain_reference text,
  ledger bigint,

  tx_status text,

  verify_mode text NOT NULL DEFAULT 'raw_tx'
    CHECK (verify_mode IN (
      'raw_tx',
      'tx_lookup',
      'ledger_scan',
      'manual_chain_check'
    )),

  /* =====================================================
     VERIFY STATE MACHINE (RPC PIPELINE)
  ===================================================== */

  verified boolean NOT NULL DEFAULT false,

  verify_stage text NOT NULL DEFAULT 'RPC_FETCH'
    CHECK (verify_stage IN (
      'RPC_FETCH',
      'RPC_PARSE',
      'AMOUNT_CHECK',
      'RECEIVER_CHECK',
      'SENDER_CHECK',
      'CHAIN_CONFIRM',
      'FINAL_MATCH',
      'FAILED',
      'MANUAL_REVIEW'
    )),

  verify_status text NOT NULL DEFAULT 'success'
    CHECK (verify_status IN (
      'success',
      'mismatch',
      'duplicate',
      'chain_failed',
      'manual_review'
    )),

  /* =====================================================
     🔥 NEW FIELDS (YOUR REQUEST)
  ===================================================== */

  stage text,
  reason text,

  /* =====================================================
     FINANCIAL VALIDATION SNAPSHOT
  ===================================================== */

  amount numeric(20,7) CHECK (amount >= 0),
  expected_amount numeric(20,7) CHECK (expected_amount >= 0),

  sender text,
  receiver text,
  expected_receiver text,

  amount_match boolean,
  receiver_match boolean,
  sender_match boolean,

  /* =====================================================
     FRAUD / RISK FLAGS
  ===================================================== */

  duplicate_flag boolean NOT NULL DEFAULT false,
  fraud_flag boolean NOT NULL DEFAULT false,
  manual_review_flag boolean NOT NULL DEFAULT false,

  mismatch_reason text,
  fraud_reason text,

  /* =====================================================
     IMMUTABLE VERIFICATION HASH
  ===================================================== */

  verification_hash text,

  /* =====================================================
     RAW CHAIN PAYLOAD (FORENSIC DEBUG)
  ===================================================== */

  payload jsonb,

  /* =====================================================
     TIMESTAMP TRACE
  ===================================================== */

  verified_at timestamptz NOT NULL DEFAULT now(),
  created_at timestamptz NOT NULL DEFAULT now()
);
