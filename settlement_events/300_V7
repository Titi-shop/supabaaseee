CREATE TABLE settlement_events (

    id uuid PRIMARY KEY
        DEFAULT gen_random_uuid(),

    escrow_id uuid NULL
        REFERENCES escrow_entries(id)
        ON DELETE CASCADE,

    withdrawal_id uuid NULL
        REFERENCES wallet_withdrawals(id)
        ON DELETE CASCADE,

    payment_intent_id uuid NULL
        REFERENCES payment_intents(id)
        ON DELETE CASCADE,

    event_type text NOT NULL,

    source text NOT NULL,

    reason text NULL,

    metadata jsonb NOT NULL
        DEFAULT '{}'::jsonb,

    event_hash text,

    created_at timestamptz NOT NULL
        DEFAULT now(),

    CONSTRAINT settlement_events_ref_check
    CHECK (

        (
            CASE
                WHEN escrow_id IS NOT NULL
                THEN 1 ELSE 0
            END

          +

            CASE
                WHEN withdrawal_id IS NOT NULL
                THEN 1 ELSE 0
            END

          +

            CASE
                WHEN payment_intent_id IS NOT NULL
                THEN 1 ELSE 0
            END

        ) = 1

    )

);
