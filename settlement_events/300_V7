CREATE TABLE settlement_events (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),

  /* =====================================================
     CORE LINK (ESCROW SOURCE OF TRUTH)
  ===================================================== */

  escrow_id uuid NOT NULL
    REFERENCES escrow_entries(id)
    ON DELETE CASCADE,

  /* =====================================================
     EVENT CLASSIFICATION (SETTLEMENT PIPELINE)
  ===================================================== */

  event_type text NOT NULL,

  source text NOT NULL,

  reason text,

  /* =====================================================
     EVENT PAYLOAD (FORENSIC + REPLAY SAFE)
  ===================================================== */

  metadata jsonb NOT NULL DEFAULT '{}'::jsonb,

  /* =====================================================
     INTEGRITY CONTROL (IMMUTABLE EVENT CHAIN)
  ===================================================== */

  event_hash text,

  /* =====================================================
     TIMESTAMP
  ===================================================== */

  created_at timestamptz NOT NULL DEFAULT now()
);
