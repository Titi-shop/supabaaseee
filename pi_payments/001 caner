CREATE TABLE pi_payments (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),

  /* ================= USER ================= */

  user_id uuid NOT NULL
    REFERENCES users(id)
    ON DELETE RESTRICT,

  /* ================= PI CORE ================= */

  pi_payment_id text NOT NULL UNIQUE, -- idempotency chính
  txid text,                          -- blockchain tx (không unique)

  /* ================= MONEY ================= */

  amount numeric NOT NULL CHECK (amount >= 0),
  currency text NOT NULL DEFAULT 'PI'
    CHECK (currency = 'PI'),

  /* ================= STATUS ================= */

  status text NOT NULL DEFAULT 'pending'
    CHECK (status IN (
      'pending',     -- vừa tạo
      'verified',    -- đã verify Pi
      'completed',   -- đã tạo order
      'failed'       -- lỗi
    )),

  /* ================= SECURITY ================= */

  -- snapshot để chống sửa giá
  expected_amount numeric,  -- giá server tính
  verified_amount numeric,  -- giá từ Pi

  -- chống replay / double call
  idempotency_key text UNIQUE,

  /* ================= CONTEXT ================= */

  country text,
  zone text,

  /* ================= ORDER LINK ================= */

  order_id uuid
    REFERENCES orders(id)
    ON DELETE SET NULL,

  /* ================= RAW DATA ================= */

  raw jsonb, -- full response từ Pi (debug + fraud)

  /* ================= METADATA ================= */

  note text,

  /* ================= TIME ================= */

  created_at timestamptz NOT NULL DEFAULT now(),
  updated_at timestamptz NOT NULL DEFAULT now(),
  completed_at timestamptz,

  /* ================= INDEX ================= */

  CONSTRAINT idx_pi_payment_user UNIQUE (user_id, pi_payment_id)
);
