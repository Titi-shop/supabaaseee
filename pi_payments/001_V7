CREATE TABLE pi_payments (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),

  /* =====================================================
     ROOT LINK (INTENT-BASED FLOW)
  ===================================================== */

  payment_intent_id uuid NOT NULL
    REFERENCES payment_intents(id)
    ON DELETE CASCADE,

  order_id uuid
    REFERENCES orders(id)
    ON DELETE SET NULL,

  user_id uuid NOT NULL
    REFERENCES users(id)
    ON DELETE RESTRICT,

  /* =====================================================
     PI NETWORK CORE IDENTIFIERS
  ===================================================== */

  pi_payment_id text NOT NULL UNIQUE,
  txid text UNIQUE,

  payment_nonce text,
  verify_token text,

  receiver_wallet text,

  /* =====================================================
     FINANCIAL STATE (EXECUTION LAYER)
  ===================================================== */

  amount numeric(20,7) NOT NULL CHECK (amount >= 0),
  expected_amount numeric(20,7),
  verified_amount numeric(20,7),

  currency text NOT NULL DEFAULT 'PI'
    CHECK (currency = 'PI'),

  /* =====================================================
     EXECUTION STATE MACHINE (RUNTIME FLOW)
  ===================================================== */

  status text NOT NULL DEFAULT 'PENDING'
    CHECK (status IN (
      'PENDING',
      'PI_VERIFIED',
      'RPC_VERIFIED',
      'FINALIZED',
      'PI_COMPLETED',
      'SETTLED',
      'FAILED',
      'MANUAL_REVIEW'
    )),

  /* =====================================================
     RECONCILIATION CONTROL (ANTI-RACE + RETRY SAFE)
  ===================================================== */

  reconcile_attempts integer NOT NULL DEFAULT 0
    CHECK (reconcile_attempts >= 0),

  last_reconcile_at timestamptz,

  processing_lock_id uuid,
  processing_locked_at timestamptz,

  /* =====================================================
     RAW PAYLOAD STORAGE (FORENSIC TRACE)
  ===================================================== */

  pi_raw_payload jsonb,
  rpc_raw_payload jsonb,
  complete_raw_payload jsonb,

  /* =====================================================
     FAILURE HANDLING (NO RAW ERROR LEAK)
  ===================================================== */

  failure_reason text,
  manual_review_reason text,
  note text,

  /* =====================================================
     IDEMPOTENCY CONTROL
  ===================================================== */

  idempotency_key text UNIQUE,

  /* =====================================================
     GEO / CONTEXT (OPTIONAL METADATA)
  ===================================================== */

  country text,
  zone text,

  /* =====================================================
     TIMESTAMPS
  ===================================================== */

  created_at timestamptz NOT NULL DEFAULT now(),
  updated_at timestamptz NOT NULL DEFAULT now(),
  completed_at timestamptz
);
