CREATE TABLE payment_receipts (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),

  /* =====================================================
     CORE LINK
  ===================================================== */

  payment_intent_id uuid NOT NULL
    REFERENCES payment_intents(id)
    ON DELETE CASCADE,

  user_id uuid
    REFERENCES users(id)
    ON DELETE SET NULL,

  order_id uuid
    REFERENCES orders(id)
    ON DELETE SET NULL,

  escrow_id uuid
    REFERENCES escrow_entries(id)
    ON DELETE SET NULL,

  /* =====================================================
     PI PAYMENT IDENTITY
  ===================================================== */

  pi_payment_id text NOT NULL UNIQUE,
  pi_uid text,
  txid text,

  /* =====================================================
     VERIFIED MONEY
  ===================================================== */

  expected_amount numeric(20,8) NOT NULL,
  verified_amount numeric(20,8) NOT NULL,

  currency text NOT NULL DEFAULT 'PI'
    CHECK (currency = 'PI'),

  /* =====================================================
     WALLET TRACE
  ===================================================== */

  sender_wallet text,
  receiver_wallet text,

  /* =====================================================
     VERIFY STATE
  ===================================================== */

  verification_status text NOT NULL DEFAULT 'pi_verified'
    CHECK (
      verification_status IN (
        'pi_verified',
        'rpc_verified',
        'completed',
        'manual_review',
        'failed'
      )
    ),

  verify_source text NOT NULL DEFAULT 'PI_SERVER'
    CHECK (
      verify_source IN (
        'PI_SERVER',
        'RPC_NODE',
        'DUAL_AUDIT',
        'MANUAL'
      )
    ),

  /* =====================================================
     RPC CHAIN AUDIT
  ===================================================== */

  rpc_confirmed boolean NOT NULL DEFAULT false,
  rpc_ledger bigint,
  chain_reference text,
  tx_status text,

  /* =====================================================
     RAW FORENSIC PAYLOADS
  ===================================================== */

  pi_payload jsonb,
  rpc_payload jsonb,
  merged_payload jsonb,

  /* =====================================================
     SECURITY / HASH TRACE
  ===================================================== */

  forensic_hash text,
  idempotency_key text,

  /* =====================================================
     REVIEW
  ===================================================== */

  failure_reason text,
  manual_note text,

  /* =====================================================
     TIME
  ===================================================== */

  verified_at timestamptz,
  completed_at timestamptz,
  created_at timestamptz NOT NULL DEFAULT now(),
  updated_at timestamptz NOT NULL DEFAULT now()
);
