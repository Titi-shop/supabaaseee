CREATE TABLE payment_receipts (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),

  /* =====================================================
     CORE RELATION (UUID ONLY)
  ===================================================== */

  payment_intent_id uuid NOT NULL
    REFERENCES payment_intents(id)
    ON DELETE CASCADE,

  user_id uuid
    REFERENCES users(id)
    ON DELETE SET NULL,

  order_id uuid
    REFERENCES orders(id)
    ON DELETE SET NULL,

  escrow_id uuid
    REFERENCES escrow_entries(id)
    ON DELETE SET NULL,

  /* =====================================================
     PI NETWORK SNAPSHOT (NON-RELATIONAL)
  ===================================================== */

  pi_payment_id text NOT NULL UNIQUE,
  pi_uid text,
  txid text,

  /* =====================================================
     FINANCIAL SNAPSHOT (IMMUTABLE RECEIPT CORE)
  ===================================================== */

  expected_amount numeric(20,8) NOT NULL,
  verified_amount numeric(20,8) NOT NULL,

  currency text NOT NULL DEFAULT 'PI'
    CHECK (currency = 'PI'),

  /* =====================================================
     WALLET TRACEABILITY
  ===================================================== */

  sender_wallet text,
  receiver_wallet text,

  /* =====================================================
     VERIFICATION STATE MACHINE
  ===================================================== */

  verification_status text NOT NULL DEFAULT 'pi_verified'
    CHECK (
      verification_status IN (
        'pi_verified',
        'rpc_verified',
        'completed',
        'manual_review',
        'failed'
      )
    ),

  verify_source text NOT NULL DEFAULT 'PI_SERVER'
    CHECK (
      verify_source IN (
        'PI_SERVER',
        'RPC_NODE',
        'DUAL_AUDIT',
        'MANUAL'
      )
    ),

  /* =====================================================
     BLOCKCHAIN / RPC CONFIRMATION LAYER
  ===================================================== */

  rpc_confirmed boolean NOT NULL DEFAULT false,
  rpc_ledger bigint,
  chain_reference text,
  tx_status text,

  /* =====================================================
     FORENSIC PAYLOAD (RAW DATA STORAGE)
  ===================================================== */

  pi_payload jsonb,
  rpc_payload jsonb,
  merged_payload jsonb,

  /* =====================================================
     SECURITY / IDEMPOTENCY CONTROL
  ===================================================== */

  forensic_hash text,
  idempotency_key text,

  /* =====================================================
     FAILURE / REVIEW TRACKING
  ===================================================== */

  failure_reason text,
  manual_note text,

  /* =====================================================
     TIMESTAMPS (AUDIT FINALIZATION)
  ===================================================== */

  verified_at timestamptz,
  completed_at timestamptz,
  created_at timestamptz NOT NULL DEFAULT now(),
  updated_at timestamptz NOT NULL DEFAULT now()
);
